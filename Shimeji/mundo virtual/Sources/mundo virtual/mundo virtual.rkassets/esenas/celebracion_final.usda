#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["asamblado4_1", "asamblado4", "RCP_BehaviorsContainer", "cappi_animado", "ambos_celebrando", "OnAddedToScene"]
    float3 xformOp:translate = (-0.10721004, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def "cappi_animado" (
        active = true
        customData = {
            float3 rotationEulerHint = (0, -0.39209414, 0)
        }
        references = @../capi modelos/cappi animado.usda@
    )
    {
        quatf xformOp:orient = (0.98084426, 0, -0.19479364, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0.5058121, 0, -0.0012964457)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Carpincho_mapa" (
            active = false
        )
        {
        }

        over "Carpincho_parado"
        {
            over "AnimationLibrary"
            {
                over "Carpincho_caminar"
                {
                    uniform bool looping = 1
                    uniform string name = "Carpincho_caminar"
                }

                over "Carpincho_celebrar"
                {
                    uniform bool looping = 1
                    uniform string name = "Carpincho_celebrar"
                }
            }
        }
    }

    def RealityKitComponent "RCP_BehaviorsContainer"
    {
        rel behaviors = </Root/OnAddedToScene>
        uniform token info:id = "RCP.BehaviorsContainer"
    }

    def RealityKitTimeline "ambos_celebrando"
    {
        reorder nameChildren = ["Track2", "Track"]
        def RealityKitTrack "Track2"
        {
            def RealityKitAction "Animation"
            {
                string actionKind = "animation"
                string animation = "Carpincho_celebrar"
                int blendLayer = 500
                double duration = 0.9583333134651184
                uniform token info:id = "B0778DCB-3971-4292-B818-5B022D865E15"
                double loopCount = 0
                bool separateAnimatedValue = 1
                double startTime = 0
                rel target = </Root/cappi_animado/Carpincho_parado>

                def RealityKitStruct "handoffType"
                {
                }
            }
        }

        def RealityKitTrack "Track"
        {
            def RealityKitAction "Animation"
            {
                string actionKind = "animation"
                string animation = "Ajolote_celebrar"
                int blendLayer = 500
                double duration = 0.9583333134651184
                uniform token info:id = "37A9002C-4BEE-427E-A88C-8861D4EA638B"
                double loopCount = 0
                bool separateAnimatedValue = 1
                double startTime = 0
                rel target = </Root/asamblado4_1/Ajolote_celebrar_1>

                def RealityKitStruct "handoffType"
                {
                }
            }
        }
    }

    def Preliminary_Behavior "OnAddedToScene"
    {
        rel actions = </Root/OnAddedToScene/Action>
        uniform bool exclusive
        rel triggers = </Root/OnAddedToScene/Trigger>

        def Preliminary_Trigger "Trigger"
        {
            rel affectedObjects = </Root>
            token info:id = "SceneTransition"
        }

        def Preliminary_Action "Action"
        {
            rel affectedObjects = </Root>
            rel animationLibraryKey = </Root/ambos_celebrando>
            rel animationLibraryKeyOverrideKey = </Root/OnAddedToScene/Trigger>
            token info:id = "PlayTimeline"
            int loops = 0
            int performCount = 1
            token type = "serial"
        }
    }

    def "asamblado4_1" (
        active = true
        customData = {
            float3 rotationEulerHint = (0, 0.49155343, 0)
        }
        prepend references = @../ajo_modelos/animaciones/asamblado4.usda@
    )
    {
        quatf xformOp:orient = (0.96994865, 0, 0.24330977, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (-0.3993041, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "AnimationLibrary"
        {
            token info:id = "RealityKit.AnimationLibrary"

            def RealityKitAnimationFile "Ajolote_celebrar"
            {
                uniform asset file = @../ajo_modelos/animaciones/Ajolote_celebrar.usdz@
                uniform bool looping = 1
                uniform string name = "Ajolote_celebrar"
            }
        }

        over "Ajolote_celebrar_1"
        {
            over "AnimationLibrary"
            {
                def RealityKitAnimationFile "Ajolote_celebrar"
                {
                    uniform asset file = @../ajo_modelos/animaciones/Ajolote_celebrar.usdz@
                    uniform bool looping = 1
                    uniform string name = "Ajolote_celebrar"
                }
            }
        }
    }
}

